# Envío del formulario de contacto (opcional).
# Crea una cuenta gratuita en https://resend.com, verifica tu dominio y rellena esto.
# Sin estas variables el formulario funciona igual, pero los mensajes solo se ven en los logs del servidor.
RESEND_API_KEY=
CONTACT_TO=tu-email@dominio.com
CONTACT_FROM=Mate Studio <web@tudominio.com>
