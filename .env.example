# Envío del formulario de contacto por email con Resend (https://resend.com, plan gratuito).
# Mientras no tengas dominio propio: regístrate en Resend con tu email personal y pon ese mismo
# email en CONTACT_TO. Resend deja enviar desde onboarding@resend.dev a la dirección de tu cuenta.
RESEND_API_KEY=
CONTACT_TO=tu-email-personal@gmail.com
# Cuando verifiques tu dominio en Resend, cambia el remitente:
# CONTACT_FROM=Mate Studio <web@tudominio.com>

# Opcional: dirección pública de la web (si no, se usa la de Vercel)
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
